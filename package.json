{
    "name": "ollama-chat-vscode",
    "displayName": "Ollama Local Chat",
    "description": "Chat with Ollama locally in VS Code",
    "version": "0.0.3",
    "engines": {
        "vscode": "^1.74.0"
    },
    "packageManager": "bun@1.2.3",
    "publisher": "MauroKrekels",
    "license": "MIT",
    "galleryBanner": {
        "color": "#000000",
        "theme": "dark"
    },
    "keywords": [
        "ollama",
        "chat",
        "vscode"
    ],
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:ollama.openChat"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Maurokrekels/ollama-vscode"
    },
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ollama.openChat",
                "title": "Open Ollama Chat"
            }
        ],
        "configuration": {
            "title": "Ollama",
            "properties": {
                "ollama.baseUrl": {
                    "type": "string",
                    "default": "http://localhost:11434",
                    "description": "Ollama API base URL"
                },
                "ollama.model": {
                    "type": "string",
                    "default": "llama3.2:latest",
                    "description": "Default Ollama model to use"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "bun run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "^16.18.126",
        "typescript": "^4.9.5"
    }
}