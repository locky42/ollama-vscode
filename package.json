{
    "name": "ollama-vscode",
    "displayName": "Ollama Chat",
    "description": "Chat with Ollama locally in VS Code",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:ollama.openChat"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Maurokrekels/ollama-vscode"
    },
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ollama.openChat",
                "title": "Open Ollama Chat"
            }
        ],
        "configuration": {
            "title": "Ollama",
            "properties": {
                "ollama.baseUrl": {
                    "type": "string",
                    "default": "http://localhost:11434",
                    "description": "Ollama API base URL"
                },
                "ollama.model": {
                    "type": "string",
                    "default": "llama3.2:latest",
                    "description": "Default Ollama model to use"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "16.x",
        "typescript": "^4.9.4"
    }
}